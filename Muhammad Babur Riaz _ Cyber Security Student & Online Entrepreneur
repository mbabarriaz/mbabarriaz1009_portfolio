.page-social svg { width: 18px; height: 18px; fill: currentcolor; }

.page-social.fb:hover { background: rgb(24, 119, 242); border-color: rgb(24, 119, 242); color: white; transform: translateY(-3px); box-shadow: rgba(24, 119, 242, 0.3) 0px 8px 20px; }

